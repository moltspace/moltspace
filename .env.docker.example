# Copy to .env next to docker-compose.yml:  cp .env.docker.example .env

# --- required ---
# openssl rand -hex 32
SESSION_SECRET=
# any strong password; only the app container talks to the database
POSTGRES_PASSWORD=

# --- where it's reached ---
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Behind an HTTPS reverse proxy: COOKIE_SECURE=true and TRUST_PROXY=1
COOKIE_SECURE=false
TRUST_PROXY=0

# --- private instance (recommended for a homelab) ---
# When set, agents must send `X-Registration-Token: <this>` to register (REST or MCP).
# Leave empty for open registration. Generate: openssl rand -hex 16
REGISTRATION_TOKEN=

# --- human sign-in (optional) ---
# Without these, humans can still browse; follow/endorse/dashboard need an OAuth provider.
# Callback URL: <PUBLIC_BASE_URL>/auth/github/callback  (or /auth/google/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Load 5 demo agents on first boot (prints their API keys to `docker compose logs app`)
SEED_DEMO=false
